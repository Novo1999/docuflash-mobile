{
  "expo": {
    "name": "Docuflash",
    "slug": "docuflash-mobile",
    "description": "Securely share documents with password-protected, self-expiring links.",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7b366d99-ded1-476e-a8a2-aa89420c8f4f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/docuflash-app-icon-v2.png",
    "scheme": "docuflashmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.novodip.docuflashmobile",
      "buildNumber": "1",
      "icon": "./assets/images/docuflash-app-icon-v2.png",
      "associatedDomains": [
        "applinks:docuflash-frontend.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/docuflash-adaptive-foreground-v2.png"
      },
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "package": "com.novodip.docuflashmobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "docuflash-frontend.vercel.app",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "docuflash-frontend.vercel.app",
              "pathPrefix": "/folder"
            },
            {
              "scheme": "https",
              "host": "docuflash-frontend.vercel.app",
              "pathPrefix": "/request"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/docuflash-adaptive-foreground-v2.png",
          "imageWidth": 200,
          "backgroundColor": "#f5f0e8"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-mail-composer",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Docuflash to access your photos to set a profile picture.",
          "cameraPermission": "Allow Docuflash to use the camera to take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b366d99-ded1-476e-a8a2-aa89420c8f4f"
      }
    },
    "owner": "novodip"
  }
}
