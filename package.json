    "web": "expo start --web",
    "lint": "expo lint",
    "build:development:android": "npx --yes eas-cli@latest build --profile development --platform android",
    "build:development:ios": "npx --yes eas-cli@latest build --profile development --platform ios",
    "build:preview:android": "npx --yes eas-cli@latest build --profile preview --platform android",
