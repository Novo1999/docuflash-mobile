    "build:preview": "npx --yes eas-cli@latest build --profile preview --platform all",
    "build:android": "npx --yes eas-cli@latest build --profile production --platform android",
    "build:ios": "npx --yes eas-cli@latest build --profile production --platform ios",
    "build": "npx --yes eas-cli@latest build --profile production --platform all",
